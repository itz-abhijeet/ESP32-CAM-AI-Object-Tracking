# ESP32-CAM MJPEG Stream URL
CAMERA_URL=http://192.168.1.50:81/stream

# Serial port for ESP32 controller (on Linux/Docker host, e.g. /dev/ttyUSB0 or /dev/ttyACM0)
SERIAL_PORT=/dev/ttyUSB0

# Model path (use ../models/best.pt or yolov8n.pt)
MODEL_PATH=../models/best.pt

# Run without GUI display inside container (true/false)
HEADLESS=true

# Target object class for webcam test tracking (e.g. airplane, cell phone, person, bottle, cup)
TARGET_CLASS=airplane

# Servo direction signs (-1 or 1)
PAN_SIGN=-1
TILT_SIGN=-1
